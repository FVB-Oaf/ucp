  <library_effects>
    <effect id="fullsize-effect">
      <profile_COMMON>
        <newparam sid="fullsize_main_b_color_png-surface">
          <surface type="2D">
            <init_from>fullsize_main_b_color_png</init_from>
          </surface>
        </newparam>
        <newparam sid="fullsize_main_b_color_png-sampler">
          <sampler2D>
            <source>fullsize_main_b_color_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="fullsize_main_b_color_png-sampler" texcoord="Mesh_006-mesh-map-0"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">1</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>

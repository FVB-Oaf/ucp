            {"selfCollision":true,"collision":true,"frictionCoef":0.5,"nodeMaterial":"|NM_GLASS","group":["pigeon_windshield","gps"],"nodeWeight":0.3},
            ["wi1",0,-0.44,1.19],
            {"nodeMaterial":"|NM_PLASTIC","nodeWeight":0.45},
            ["p2r",-0.549,-0.421,1.181,{"group":["pigeon_body","gps","pigeon_windshield"]}],
            ["p2l",0.549,-0.421,1.181,{"group":["pigeon_body","gps","pigeon_windshield"]}],
            {"nodeWeight":0.45},
            ["rf1r",-0.483,-0.216,1.45,{"group":["pigeon_roof","pigeon_body","gps","pigeon_windshield"]}],
            ["rf1",0,-0.232,1.472,{"nodeWeight":0.3,"group":["pigeon_roof","pigeon_body","gps","pigeon_windshield"]}],
            ["rf1l",0.483,-0.216,1.45,{"group":["pigeon_roof","pigeon_body","gps","pigeon_windshield"]}],
            {"nodeWeight":0.75,"group":["gps","pigeon_windshield","pigeon_dash","pigeon_body"]},
            ["b6rr",-0.611,-0.6,0.912],
            ["b6r",-0.244,-0.622,0.925],
            ["b6l",0.244,-0.622,0.925],
            ["b6ll",0.611,-0.6,0.912,{"group":["gps","pigeon_windshield","pigeon_body"]}],
            {"group":""}
        ],
        "beams": [
            ["id1:","id2:"],
            {"beamPrecompression":1,"beamType":"|NORMAL","beamLongBound":1,"beamShortBound":1,"disableMeshBreaking":true,"disableTriangleBreaking":true,"beamSpring":241000,"beamDamp":40,"beamDeform":1500,"beamStrength":"FLT_MAX","deformLimitExpansion":"","deformGroup":"windshield_break","deformationTriggerRatio":0.03},
            ["wi1","rf1"],
            ["p1r","wi1"],
            ["p1l","wi1"],
            ["wi1","b6r"],
            ["wi1","b6l"],
            ["wi1","rf2"],
            ["rf1r","wi1"],
            ["rf1l","wi1"],
            ["wi1","b6rr"],
            ["wi1","b6ll"],
            {"beamDeform":1000,"beamStrength":1000},
            ["p1r","p1l"],
            ["rf1r","b6r"],
            ["rf1l","b6l"],
            ["rf1","b6r"],
            ["rf1","b6l"],
            {"breakGroup":"","deformGroup":"","deformationTriggerRatio":"","disableMeshBreaking":false,"disableTriangleBreaking":false,"deformLimitExpansion":1.2,"beamPrecompression":1,"beamType":"|NORMAL","beamLongBound":1.0,"beamShortBound":1.0}
        ],
        "triangles":[
            ["id1:","id2:","id3:"],
            {"groundModel":"glass","dragCoef":2.8,"group":"pigeon_windshield"},
            ["p1r","b6r","b6l"],
            ["p1l","p1r","b6l"],
            ["rf1","p1r","p1l"],
            {"group":""}
        ]
    },
